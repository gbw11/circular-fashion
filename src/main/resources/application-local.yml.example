# 로컬 개발용 설정 템플릿.
#
# 이 파일을 같은 폴더에 application-local.yml 로 복사하고 자기 값을 채운다.
#
#   cp application-local.yml.example application-local.yml
#
# application-local.yml 은 .gitignore 에 들어 있어 커밋되지 않는다.
# 반대로 이 .example 파일은 커밋된다 — 다음 사람이 어떤 값이 필요한지 알아야 하기 때문이다.
# 그래서 **여기에는 실제 값을 절대 적지 않는다.**
#
# 실행:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# application.yml 의 ${...} 기본값을 이 파일이 덮어쓴다. 환경변수를 쓰던 방식도 그대로
# 동작하며, 환경변수가 있으면 그쪽이 이긴다.
#
# ⚠️ 이미 application-local.yml 을 만들어 둔 사람도 이 파일이 바뀌면 다시 봐야 한다.
#    없는 키가 생기면 기동이 실패하거나(app.qr.base-url) 동작이 조용히 달라진다
#    (app.material.on-chain). 아래 "필수" 표시가 붙은 것부터 확인할 것.

spring:
  datasource:
    # ⚠️ 포트가 3307 이다. MySQL 을 기본 포트(3306)로 설치했다면 3306 으로 바꾼다.
    #    my.ini 의 port 값을 확인하면 된다.
    url: jdbc:mysql://localhost:3307/upcycle
    username: root
    password: 여기에_MySQL_비밀번호

app:
  geocoding:
    kakao:
      # Kakao Developers 앱의 REST API 키. JavaScript 키가 아니다.
      rest-api-key: 여기에_카카오_REST_API_키
      # 기존 업체 좌표 backfill이 필요한 한 번만 true로 기동 후 다시 false.
      backfill-enabled: false

  qr:
    # 필수. 비어 있으면 기동하지 않는다 — 잘못된 주소로 인쇄된 QR 은 되돌릴 수 없다.
    base-url: http://localhost:5173/passport

  # 배포된 컨트랙트 좌표. 정본은 blockchain 레포의 deployments/ssafy.json 이다.
  #
  # 비워 두면 /chain 엔드포인트가 전부 501 BLOCKCHAIN_NOT_CONFIGURED 로 거절한다.
  # 프론트의 VITE_*_CONTRACT_ADDRESS 와 반드시 같은 배포분이어야 한다 — 어긋나면 화면은
  # 새 컨트랙트에 서명하는데 서버는 옛 주소로 기록한다.
  blockchain:
    chain-id: 31221
    material-token-address: 여기에_MaterialToken_주소
    marketplace-address: 여기에_Marketplace_주소
    production-registry-address: 여기에_ProductionRegistry_주소

  material:
    # 소재 보유 행을 언제 만드는가.
    #
    #   false (기본)  등록하는 순간 만든다. 체인이 아예 없는 환경용이다.
    #   true          지갑에서 mint 를 컨펌하고 그 결과가 서버에 기록될 때 만든다.
    #
    # ⚠️ true 로 두려면 위 blockchain 주소가 채워져 있어야 한다. 주소 없이 true 면
    #    /chain 이 501 이라 보유 행이 영영 생기지 않고, 등록한 소재를 팔 수도 가공에
    #    넣을 수도 없게 된다 — 오류 없이 아무것도 안 되는 상태라 원인을 찾기 어렵다.
    on-chain: true

  storage:
    # 기본값이 /app/files 라 컨테이너 기준 경로다. 윈도우에서 IDE 로 직접 실행하면
    # 그 경로를 만들려다 막힐 수 있어 프로젝트 안으로 돌린다.
    type: local
    root: ./.local-files

  security:
    jwt:
      # Base64 로 인코딩된 32바이트 이상이어야 한다. 아니면 부팅이 실패한다
      # (Illegal base64 character / key too short).
      #
      # 생성:
      #   PowerShell:
      #     [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
      #   또는:
      #     openssl rand -base64 32
      secret: 여기에_Base64_시크릿

  payment:
    kakaopay:
      # 카카오페이 developers 에서 받은 **Secret key(dev)** 를 넣는다.
      #
      # ⚠️ PRD 키를 넣지 않는다. 실제 청구가 일어나는 값이고 로컬에 둘 이유가 없다.
      #
      # 비워 두면 MockPaymentGateway 가 붙는다 — 결제창만 열리지 않고 나머지 흐름
      # (금액 대조, 상태 전이, 취소 시 수량 복구)은 그대로 동작한다. 시작 로그에
      # 어느 쪽이 붙었는지 남는다.
      secret-key: 여기에_Secret_key_dev

      # 가맹점 코드. 콘솔에 별도 코드가 발급되지 않았으면 이 값을 그대로 둔다
      # (TC0ONETIME 은 카카오가 공개한 테스트 가맹점이라 실제 청구가 없다).
      # 비밀값이 아니다.
      cid: TC0ONETIME

      # 가공비 결제 후 돌아올 프론트 주소. 로컬 프론트 포트를 바꾼 경우에만 수정한다.
      processing-return-url: http://localhost:5173/processing/jobs/{jobId}/payment/callback
